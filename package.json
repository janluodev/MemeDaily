{
  "name": "memedaily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "lint:complexity": "eslint . --config eslint.complexity.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate-data.ts",
    "validate:news": "tsx scripts/validate-news.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run audit:prod && npm run validate && npm run validate:news && npm run lint && npm run typecheck && npm test && npm run build",
    "fallback:skipped": "tsx scripts/create-skipped-day.ts",
    "fallback:skipped:news": "tsx scripts/create-skipped-news-day.ts",
    "stamp:publish": "tsx scripts/stamp-publish-time.ts"
  },
  "dependencies": {
    "lucide-react": "^1.26.0",
    "next": "^16.4.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2"
  }
}
